{
  "name": "your-app",
  "version": "1.0.0",
  "main": "electron/main.js",
  "build": {
    "appId": "com.yourcompany.yourapp",
    "productName": "DISC Personality App",
    "asar": false,
    "afterPack": "scripts/install-backend-deps.js",
    "files": [
      "electron/**/*",
      "backend/**/*",
      "my-project/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "railway_reg.db",
        "to": "railway_reg.db"
      },
      {
        "from": "electron/node.exe",
        "to": "node.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "buildResources": "assets"
    }
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "cd my-project && npm install && npm run build",
    "prepare-backend": "cd backend && npm install && npx electron-rebuild -f -w sqlite3 --version 29.4.6",
    "postinstall": "electron-builder install-app-deps",
    "pack": "npm run build && npm run prepare-backend && electron-builder --dir",
    "dist": "npm run build && npm run prepare-backend && electron-builder"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9"
  }
}